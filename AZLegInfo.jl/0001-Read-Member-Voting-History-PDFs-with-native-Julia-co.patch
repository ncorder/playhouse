+        buffer = UInt8[]   # the text of the word so far
+        a = 1
+        while a <= length(order)
+            # The line is order[a:b], the glyphs within 40% of the first one's height.
+            top = glyphs[order[a]]
+            b = a
+            while b < length(order)
+                g = glyphs[order[b+1]]
+                abs(top.y - g.y) > 0.4 * max(min(top.size, g.size), 1.0) && break
+                b += 1
+            end
+            line = view(order, a:b)
+            a = b + 1
