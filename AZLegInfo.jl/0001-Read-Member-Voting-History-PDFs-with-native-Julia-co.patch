+    # Parses d[p:q] as a number. Returns (kind, integer, real): kind is 1 for an
+    # integer, 2 for a real number and 0 for anything else (a keyword).
+    function parse_number(d::Vector{UInt8}, p::Int, q::Int)
+        i = p
+        negative = false
+        if d[i] == UInt8('-') || d[i] == UInt8('+')
+            negative = d[i] == UInt8('-')
+            i += 1
+        end
+        whole = 0
+        fraction = 0.0
+        scale = 1.0
+        digits = 0  # before the point
+        point = false
+        while i <= q
+            b = @inbounds d[i]
+            if is_digit(b)
+                if point
+                    scale /= 10
+                    fraction += (b - UInt8('0')) * scale
+                else
+                    whole = 10 * whole + (b - UInt8('0'))
+                    digits += 1
+                end
+            elseif b == UInt8('.') && !point
+                point = true
+            else
+                return (0, 0, 0.0)
+            end
+            i += 1
+        end
+        (digits > 0 || scale < 1) || return (0, 0, 0.0)
+        # More than 18 digits could overflow an Int; such numbers are read as reals.
+        digits > 18 && return (2, 0, parse(Float64, String(d[p:q])))
+        point || return (1, negative ? -whole : whole, 0.0)
+        value = whole + fraction
+        return (2, 0, negative ? -value : value)
+    end
