+    new_lexer(data::Vector{UInt8}, pos::Int) = (data = data, pos = Ref(pos))
+
+    is_white(b::UInt8) = b == 0x20 || b == 0x0a || b == 0x0d || b == 0x09 || b == 0x0c || b == 0x00
+    is_delimiter(b::UInt8) = b == UInt8('(') || b == UInt8(')') || b == UInt8('<') || b == UInt8('>') ||
+                             b == UInt8('[') || b == UInt8(']') || b == UInt8('{') || b == UInt8('}') ||
+                             b == UInt8('/') || b == UInt8('%')
+    is_regular(b::UInt8) = !is_white(b) && !is_delimiter(b)
+    is_digit(b::UInt8) = UInt8('0') <= b <= UInt8('9')
