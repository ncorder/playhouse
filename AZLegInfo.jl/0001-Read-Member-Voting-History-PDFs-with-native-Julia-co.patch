+    # The words of a run of glyphs in the order drawn, in any direction. A new
+    # word starts after a space or where the gap from the end of the last
+    # glyph is more than 15% of the font size. Words are placed at their first
+    # and last glyphs.
+    function run_words(run)
+        words = no_words()
+        buffer = IOBuffer()
+        start = run[1]
