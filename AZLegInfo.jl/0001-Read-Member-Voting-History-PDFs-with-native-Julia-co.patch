+    function inflate_data(data::Vector{UInt8}, start::Int, max_out::Int)
+        damaged() = error("Damaged Deflate data")
+        pos, b, count, pad = start, UInt64(0), 0, 0
+        out = Vector{UInt8}(undef, clamp(4 * (length(data) - start + 1), 1024, max(max_out, 1024)))
+        n = 0  # the output so far
+        # The tables of the codes of dynamic blocks, made at the first one
+        # and reused for the next (the fixed codes stand in until then).
+        length_code = dynamic_literal_code = dynamic_distance_code = fixed_literal_code
+        tables_made = false
+        code_length_lengths, code_lengths_buffer = Int[], Int[]
+        final = false
+        while !final && n < max_out
+            pos, b, count, pad = refill(data, pos, b, count, pad)
+            final = b & 1 == 1
+            mode = Int((b >> 1) & 3)
+            b >>= 3
