+                    # Where a dictionary key belongs, anything but a name is
+                    # skipped, even the start of an array or dictionary.
+                    !isempty(open) && open[end] isa Dict && pending[end] === nothing && continue
+                    length(open) >= max_nesting &&
+                        error("PDF arrays or dictionaries nested more than $max_nesting deep")
