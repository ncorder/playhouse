+    # Decompresses zlib data: a 2-byte header, Deflate data and an Adler-32 checksum.
+    function zlib_decode(data::Vector{UInt8})
+        length(data) >= 2 || error("Damaged zlib data: no header")
+        method, flags = data[1], data[2]
+        method & 0x0f == 8 || error("Damaged zlib data: unsupported compression method")
+        method >> 4 <= 7 || error("Damaged zlib data: invalid window size")
+        flags & 0x20 == 0 || error("Damaged zlib data: a preset dictionary is not supported")
+        (UInt(method) << 8 | flags) % 31 == 0 || error("Damaged zlib data: header checksum error")
+        out, p = inflate_data(data, 3, typemax(Int))
+        p + 3 <= length(data) || error("Damaged zlib data: no checksum")
+        stored = UInt32(data[p]) << 24 | UInt32(data[p+1]) << 16 | UInt32(data[p+2]) << 8 | UInt32(data[p+3])
+        adler32(out) == stored || error("Damaged zlib data: checksum error")
