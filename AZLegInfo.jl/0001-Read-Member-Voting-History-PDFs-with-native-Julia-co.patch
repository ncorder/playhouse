+                # #xx is the byte with hexadecimal code xx
+                if d[q] == UInt8('#') && q + 2 <= n && hex_value(d[q+1]) >= 0 && hex_value(d[q+2]) >= 0
+                    push!(name, UInt8(16 * hex_value(d[q+1]) + hex_value(d[q+2])))
+                    q += 3
+                else
+                    push!(name, d[q])
+                    q += 1
+                end
+            end
+            lx.pos[] = q
+            return Symbol(String(name))
+        elseif b == UInt8('(')
+            return read_literal_string!(lx, UInt8[])
+        elseif b == UInt8('<')
