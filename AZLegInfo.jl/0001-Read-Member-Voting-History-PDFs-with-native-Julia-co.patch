+                    isempty(open) && return value
+                    value = pop!(open)
+                    pop!(pending)
+                    refs && value isa Vector{Any} && (value = join_references(value))
+                elseif value == "true"
+                    value = true
+                elseif value == "false"
+                    value = false
+                elseif value == "null"
+                    value = nothing
+                end
