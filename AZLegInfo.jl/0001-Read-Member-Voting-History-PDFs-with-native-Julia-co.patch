+    # The glyphs of a page, in the order they are drawn, in glyphs (emptied
+    # first). content is a buffer for the page's content streams.
+    function page_glyphs(doc, page::Dict{Symbol,Any}, resources, matrix::NTuple{6,Float64}, fonts,
+                         glyphs, content::Vector{UInt8})
