+    # Reads a <hexadecimal string>, starting at its "<", adding its bytes to out.
+    function read_hex_string!(lx, out::Vector{UInt8})
+        d, n = lx.data, length(lx.data)
+        p = lx.pos[] + 1
+        high = -1
+        while p <= n
+            b = d[p]
+            p += 1
+            b == UInt8('>') && break
+            v = hex_value(b)
+            v < 0 && continue  # whitespace
+            if high < 0
+                high = v
+            else
+                push!(out, UInt8(16 * high + v))
+                high = -1
+            end
+        end
+        high >= 0 && push!(out, UInt8(16 * high))  # a missing last digit is 0
+        lx.pos[] = p
+        return out
+    end
 
+    # Reads one token: a number, name, string, keyword, or one of "[", "]", "<<", ">>".
+    function read_token(lx)
