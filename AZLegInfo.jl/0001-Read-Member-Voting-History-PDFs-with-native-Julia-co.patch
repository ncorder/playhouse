+    # The Adler-32 checksum of zlib data (RFC 1950, section 8.2).
+    function adler32(data::Vector{UInt8})
+        a, b = 1, 0
+        i = 1
+        while i <= length(data)
+            stop = min(length(data), i + 5551)  # the sums cannot overflow before the modulo
+            @inbounds for k in i:stop
+                a += data[k]
+                b += a
+            end
+            a %= 65521
+            b %= 65521
+            i = stop + 1
+        end
+        return UInt32(b << 16 | a)
+    end
