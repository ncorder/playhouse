+            if value isa String
+                value == "true" && return true
+                value == "false" && return false
+                value == "null" && return nothing
+            elseif refs && value isa Int
+                # `num gen R` is a reference.
+                start = lx.pos[]
+                gen = read_token(lx)
+                gen isa Int && read_token(lx) == "R" && return value => gen
+                lx.pos[] = start
+            end
+            return value
+        end
