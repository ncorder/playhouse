+                            end
+                            append!(buffer, codeunits(part))
+                        end
+                    else
+                        append!(buffer, codeunits(g.text))
+                    end
+                end
+                right = max(right, g.x + g.width)
+            end
+            isempty(buffer) || push!(words, (text = word_text(buffer), x = start, right = right))
+            empty!(buffer)
+            isempty(words) || push!(out, (y = glyphs[line[1]].y, words = words))
+        end
+        # Runs of glyphs that are not horizontal, placed among the lines by where they start.
+        if length(order) < length(glyphs)
+            run = similar(glyphs, 0)
+            for (i, g) in enumerate(glyphs)
