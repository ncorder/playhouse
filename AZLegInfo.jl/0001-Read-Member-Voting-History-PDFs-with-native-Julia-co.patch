+# Offline tests for the pure-Julia PDF and zip readers, src/PDFText.jl and
+# src/ZipReader.jl. They build small PDFs and zip files in memory, so they
+# need no network access. They run as part of the package's tests
+# (test/runtests.jl), or on their own from the package folder with:
+#
+#     julia --project=. -e 'using Pkg; Pkg.instantiate()'   # once
+#     julia --project=. test/readers.jl
+#
+# Citations:
+#   Code generated by Claude Code, Anthropic, September 24, 2026, https://claude.ai/code/session_019awDnsGJAcXbzPNQg6VhqU.
+
+using Test
+include(joinpath(@__DIR__, "..", "src", "PDFText.jl"))
+include(joinpath(@__DIR__, "..", "src", "ZipReader.jl"))
+
+# ---------------------------------------------------------------------------
+# Building test PDFs
+# ---------------------------------------------------------------------------
+
+"A PDF of the given objects, numbered from 1 (object 1 is the catalog), with a classic xref table."
+function make_pdf(objects::Vector{String})
+    io = IOBuffer()
+    print(io, "%PDF-1.4\n")
+    offsets = Int[]
+    for (i, object) in enumerate(objects)
+        push!(offsets, position(io))
+        print(io, "$i 0 obj\n$object\nendobj\n")
+    end
+    xref = position(io)
+    print(io, "xref\n0 $(length(objects) + 1)\n0000000000 65535 f \n")
+    for offset in offsets
+        print(io, lpad(offset, 10, '0'), " 00000 n \n")
+    end
+    print(io, "trailer\n<< /Size $(length(objects) + 1) /Root 1 0 R >>\nstartxref\n$xref\n%%EOF\n")
+    return take!(io)
+end
+
+stream_object(content; dict = "") = "<< $dict /Length $(sizeof(content)) >>\nstream\n$content\nendstream"
+
+# A Type 1 font whose glyphs from code 32 to 126 are all 500/1000 em wide.
+const HELVETICA = "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /FirstChar 32 /LastChar 126 /Widths [$(join(fill(500, 95), ' '))] >>"
+
+"""
+A one-page PDF drawing `content`. Objects 1 to 4 are the catalog, the page
+tree (which holds the resources, so the page inherits them), the page and its
+content; `extra` objects are numbered from 5.
+"""
+one_page(content; resources = "<< /Font << /F1 $HELVETICA >> >>", extra = String[]) = make_pdf([
+    "<< /Type /Catalog /Pages 2 0 R >>",
+    "<< /Type /Pages /Kids [3 0 R] /Count 1 /Resources $resources >>",
+    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R >>",
+    stream_object(content),
+    extra...,
+])
+
+words(page) = [[w.text for w in line.words] for line in page]
+
+# ---------------------------------------------------------------------------
+
+@testset "PDFText" begin
+    @testset "lines, words and positions" begin
+        pdf = one_page("""
+            BT /F1 10 Tf 36 700 Td (Bill Number) Tj 100 0 Td (HB2003) Tj ET
+            BT /F1 10 Tf 36 680 Td [(Y) -2000 (FINAL)] TJ ET
+            """)
+        pages = PDFText.read_lines(pdf)
+        @test length(pages) == 1
+        @test words(pages[1]) == [["Bill", "Number", "HB2003"], ["Y", "FINAL"]]
+        @test [line.y for line in pages[1]] ≈ [700, 680]
+        bill = pages[1][1].words[3]
+        @test bill.x ≈ 136 && bill.right ≈ 136 + 6 * 5
+        # The TJ number moves FINAL right by 2000/1000 of the font size.
+        @test pages[1][2].words[2].x ≈ 36 + 5 + 20
