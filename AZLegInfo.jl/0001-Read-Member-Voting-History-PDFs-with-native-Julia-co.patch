+# ---------------------------------------------------------------------------
+# Building test zip files
+# ---------------------------------------------------------------------------
+
+le16(x) = reinterpret(UInt8, [htol(UInt16(x))])
+le32(x) = reinterpret(UInt8, [htol(UInt32(x))])
+
+"""
+A zip of `(name, stored bytes, method, uncompressed bytes)` entries. With
+`descriptor`, the local headers leave the sizes and CRC at 0 (flag bit 3), as
+zip tools do when they write to a stream.
+"""
+function make_zip(entries; descriptor = false)
+    io = IOBuffer()
+    central = IOBuffer()
+    for (name, stored, method, contents) in entries
+        offset = position(io)
+        crc = ZipReader.crc32(contents)
+        flags = descriptor ? 0x0008 : 0x0000
+        local_sizes = descriptor ? (0, 0, 0) : (crc, length(stored), length(contents))
+        write(io, le32(0x04034b50), le16(20), le16(flags), le16(method), le16(0), le16(0),
+              le32(local_sizes[1]), le32(local_sizes[2]), le32(local_sizes[3]),
+              le16(sizeof(name)), le16(0), codeunits(name), stored)
+        descriptor && write(io, le32(0x08074b50), le32(crc), le32(length(stored)), le32(length(contents)))
+        write(central, le32(0x02014b50), le16(20), le16(20), le16(flags), le16(method), le16(0), le16(0),
+              le32(crc), le32(length(stored)), le32(length(contents)), le16(sizeof(name)), le16(0), le16(0),
+              le16(0), le16(0), le32(0), le32(offset), codeunits(name))
+    end
+    start = position(io)
+    cd = take!(central)
+    write(io, cd, le32(0x06054b50), le16(0), le16(0), le16(length(entries)), le16(length(entries)),
+          le32(length(cd)), le32(start), le16(0))
+    return take!(io)
+end
+
+le64(x) = reinterpret(UInt8, [htol(UInt64(x))])
+
+"""
+A ZIP64 zip of stored `(name, contents)` entries: the central directory's sizes
+and offsets are 0xffffffff with their values in ZIP64 extra fields, and the end
+record's numbers are in a ZIP64 end record. `count` overrides the end record's
+count.
+"""
+function make_zip64(entries; count = length(entries))
+    io, central = IOBuffer(), IOBuffer()
+    for (name, contents) in entries
+        offset = position(io)
+        crc = ZipReader.crc32(contents)
+        write(io, le32(0x04034b50), le16(45), le16(0), le16(0), le16(0), le16(0), le32(crc),
+              le32(length(contents)), le32(length(contents)), le16(sizeof(name)), le16(0), codeunits(name), contents)
+        extra = [le16(1); le16(24); le64(length(contents)); le64(length(contents)); le64(offset)]
+        write(central, le32(0x02014b50), le16(45), le16(45), le16(0), le16(0), le16(0), le16(0), le32(crc),
+              le32(0xffffffff), le32(0xffffffff), le16(sizeof(name)), le16(length(extra)), le16(0),
+              le16(0), le16(0), le32(0), le32(0xffffffff), codeunits(name), extra)
+    end
+    start = position(io)
+    cd = take!(central)
+    record = start + length(cd)
+    write(io, cd, le32(0x06064b50), le64(44), le16(45), le16(45), le32(0), le32(0), le64(count), le64(count),
+          le64(length(cd)), le64(start), le32(0x07064b50), le32(0), le64(record), le32(1),
+          le32(0x06054b50), le16(0), le16(0), le16(0xffff), le16(0xffff), le32(0xffffffff), le32(0xffffffff), le16(0))
+    return take!(io)
+end
+
+@testset "ZipReader" begin
+    @test ZipReader.crc32(codeunits("The quick brown fox jumps over the lazy dog")) == 0x414fa339
+
+    text = Vector{UInt8}("hello hello hello hello, zip!")
+    # Raw Deflate data for `text` (made with Python's zlib).
+    deflated = UInt8[0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0xc8, 0x40, 0x27, 0x75, 0x14, 0xaa, 0x32, 0x0b, 0x14, 0x01]
+    entries = [("folder/", UInt8[], 0, UInt8[]),
+               ("folder/stored.txt", Vector{UInt8}("stored"), 0, Vector{UInt8}("stored")),
+               ("déflaté.txt", deflated, 8, text)]
+    for descriptor in (false, true)
+        files = ZipReader.read_zip(make_zip(entries; descriptor = descriptor))
+        @test files == ["folder/stored.txt" => Vector{UInt8}("stored"), "déflaté.txt" => text]
+    end
+
+    # Something before the archive (such as a self-extracting program) moves every offset.
+    zip = make_zip(entries)
+    @test ZipReader.read_zip([Vector{UInt8}("#!/bin/sh a program\n"); zip]) == ZipReader.read_zip(zip)
+    # An archive comment that looks like the end of central directory record.
+    fake = [zip[1:end-2]; le16(26); Vector{UInt8}("PK\x05\x06"); zeros(UInt8, 18); Vector{UInt8}("more")]
+    @test ZipReader.read_zip(fake) == ZipReader.read_zip(zip)
+    # Names that are not UTF-8 are code page 437.
+    @test ZipReader.file_name(UInt8[0x4d, 0x81, 0x6c, 0x6c, 0x65, 0x72]) == "Müller"
+
+    # ZIP64, with and without a program before it (whose length the locator's offset leaves out).
+    small = ["a.txt" => Vector{UInt8}("first"), "b/c.bin" => UInt8[0, 1, 2, 255]]
+    zip64 = make_zip64(small)
+    @test ZipReader.read_zip(zip64) == small
+    @test ZipReader.read_zip([Vector{UInt8}("#!/bin/sh a program\n"); zip64]) == small
+    # An end record whose count does not match the central directory.
+    @test_throws ErrorException ZipReader.read_zip(make_zip64(small; count = 1))
+    @test_throws ErrorException ZipReader.read_zip(make_zip64(small; count = 0))
+
+    damaged = make_zip([("a.txt", Vector{UInt8}("abc"), 0, Vector{UInt8}("abd"))])
+    @test_throws ErrorException ZipReader.read_zip(damaged)
+    @test_throws ErrorException ZipReader.read_zip(Vector{UInt8}("not a zip file at all, just text"))
+    @test_throws ErrorException ZipReader.read_zip(make_zip([("a.bin", UInt8[1, 2], 12, UInt8[1, 2])]))
+    # Files left out by `keep` are not decompressed, so their method does not matter.
+    mixed = make_zip([("readme.txt", UInt8[1, 2], 12, UInt8[1, 2]), ("a.pdf", Vector{UInt8}("%PDF"), 0, Vector{UInt8}("%PDF"))])
+    @test ZipReader.read_zip(mixed; keep = path -> endswith(path, ".pdf")) == ["a.pdf" => Vector{UInt8}("%PDF")]
+end
