+    function join_references(items::Vector{Any})
+        out = Any[]
+        i = 1
+        while i <= length(items)
+            if i + 2 <= length(items) && items[i] isa Int && items[i+1] isa Int && items[i+2] == "R"
+                push!(out, items[i] => items[i+1])
+                i += 3
+            else
+                push!(out, items[i])
+                i += 1
+            end
+        end
+        return out
+    end
