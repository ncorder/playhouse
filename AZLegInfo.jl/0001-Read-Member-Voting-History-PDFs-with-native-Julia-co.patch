+    # The matrix that places a page upright with its bottom left corner at
+    # (0, 0), from its /MediaBox and /Rotate.
+    function page_matrix(doc, box, rotate)
+        box = resolve(doc, box)
+        x0, y0, x1, y1 = box isa AbstractVector && length(box) == 4 ?
+            [to_number(resolve(doc, v)) for v in box] : [0.0, 0.0, 612.0, 792.0]
+        x0, x1 = minmax(x0, x1)
+        y0, y1 = minmax(y0, y1)
+        angle = mod(round(to_number(resolve(doc, rotate))), 360.0)  # clockwise; a Float, as a damaged value can be huge
+        angle == 90 && return (0.0, -1.0, 1.0, 0.0, -y0, x1)
+        angle == 180 && return (-1.0, 0.0, 0.0, -1.0, x1, y1)
+        angle == 270 && return (0.0, 1.0, -1.0, 0.0, y1, -x0)
+        return (1.0, 0.0, 0.0, 1.0, -x0, -y0)
+    end
