+    # The page dictionaries in order, each with its resources and the matrix
+    # from page_matrix (section 7.7.3.4). All three can be inherited from the
+    # page tree.
+    function page_list(doc)
+        out = Tuple{Dict{Symbol,Any},Any,NTuple{6,Float64}}[]
+        catalog = resolve(doc, doc.trailer[:Root])
+        catalog isa Dict || error("Not a readable PDF: no document catalog")
+        seen = Base.IdSet{Any}()
+        # A stack rather than recursion, as page trees can be deep.
+        stack = Any[(getvalue(doc, catalog, :Pages, nothing), nothing, nothing, 0)]
+        while !isempty(stack)
+            node, resources, box, rotate = pop!(stack)
+            node = resolve(doc, node)
+            (node isa Dict && !(node in seen)) || continue  # skips cycles in the page tree
+            push!(seen, node)
+            resources = get(node, :Resources, resources)
+            box = get(node, :MediaBox, box)
+            rotate = get(node, :Rotate, rotate)
+            kids = getvalue(doc, node, :Kids, nothing)
+            if kids isa AbstractVector && getvalue(doc, node, :Type, nothing) !== :Page
+                for kid in Iterators.reverse(kids)
+                    push!(stack, (kid, resources, box, rotate))
+                end
+            else
+                push!(out, (node, resources, page_matrix(doc, box, rotate)))
+            end
+        end
+        if isempty(out)
+            # The page tree is damaged (or cut off): look for the pages themselves.
+            for num in sort!(collect(keys(doc.xref)))
+                page = get_object(doc, num)
+                if page isa Dict && get(page, :Type, nothing) === :Page
+                    push!(out, (page, get(page, :Resources, nothing),
+                                page_matrix(doc, get(page, :MediaBox, nothing), get(page, :Rotate, 0))))
+                end
+            end
+            isempty(out) && error("No pages found: the PDF is damaged or cut off")
+        end
+        return out
+    end
