+    # Sorts the glyph numbers v stably by lt: by insertion when they are
+    # nearly in order already, as a page's glyphs usually are, else (after
+    # more than 8 moves per glyph) by merge sort. Either way the order is
+    # that of any stable sort.
+    function stable_sort!(v::AbstractVector{Int}, lt)
+        moves = 0
+        for k in 2:length(v)
+            x = v[k]
+            j = k - 1
+            while j >= 1 && lt(x, v[j])
+                v[j+1] = v[j]
+                j -= 1
+            end
+            v[j+1] = x
+            moves += k - 1 - j
+            if moves > 8 * length(v)
+                sort!(v; lt = lt, alg = Base.Sort.MergeSort)
+                break
+            end
+        end
+        return v
+    end
