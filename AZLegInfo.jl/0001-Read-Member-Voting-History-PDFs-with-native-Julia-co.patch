+    codespace::Vector{Tuple{Int,UInt32,UInt32}}  # (bytes, low, high) of an embedded CMap
+    to_unicode::Dict{UInt32,String}     # from the ToUnicode CMap
+    encoding::Vector{String}            # simple fonts: text of codes 0 to 255
+    code_to_cid::Dict{UInt32,UInt32}    # composite fonts with an embedded CMap
+    widths::Dict{UInt32,Float64}        # width of a code (simple) or CID (composite), in text space units
+    default_width::Float64
+    vertical::Float64                   # vertical fonts (Identity-V): how far down a glyph moves; else 0
