+    # Reads a (literal string), starting at its opening parenthesis, adding its
+    # bytes to out.
+    function read_literal_string!(lx, out::Vector{UInt8})
+        d, n = lx.data, length(lx.data)
+        p = lx.pos[] + 1
+        depth = 1
+        while p <= n
+            b = d[p]
+            if b == UInt8('\\')
+                p += 1
+                p > n && break
+                c = d[p]
+                if c == UInt8('n')
+                    push!(out, 0x0a)
+                elseif c == UInt8('r')
+                    push!(out, 0x0d)
+                elseif c == UInt8('t')
+                    push!(out, 0x09)
+                elseif c == UInt8('b')
+                    push!(out, 0x08)
+                elseif c == UInt8('f')
+                    push!(out, 0x0c)
+                elseif UInt8('0') <= c <= UInt8('7')
+                    # Up to three octal digits; overflow past one byte is ignored.
+                    value = 0
+                    k = 0
+                    while k < 3 && p <= n && UInt8('0') <= d[p] <= UInt8('7')
